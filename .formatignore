# lefthook.yml repeats these globs in the format-codemod exclude; change both
# the format scripts in package.json read this file to skip format-codemod when no file is left

# verbatim copies that repo-sync delivers from zgeoff/tools; edit them there
.claude/hooks/skill-gate/**

# build output
**/dist/**
**/coverage/**

# design sketches that keep the layout of the design review
docs/design/boxxy/sketches/**

# the pepys glue, which `pepys build` writes and its check compares byte for byte
packages/pepys/src/generated/**

# nested checkouts
.worktrees/**
