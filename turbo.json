{
  "$schema": "./node_modules/turbo/schema.json",
  // turbo otherwise writes a guidance block into the generated AGENTS.md
  "agentGuidance": false,
  "tasks": {
    "typecheck": {
      // a package typechecks against its dependencies' source, which its own hash leaves out
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      // the CLI's tests run it against the real server, so an app may import @boxxy/server; the
      // import-zones `cli-server` edge keeps that import in the CLI's e2e tests and test helpers
      "app": {
        "dependencies": { "allow": ["module", "adapter", "lib", "package", "@boxxy/server"] }
      },
      // a module never imports an adapter; the app passes each adapter in
      "module": {
        "dependencies": { "allow": ["module", "lib"] }
      },
      "adapter": {
        "dependencies": { "allow": ["module", "lib"] }
      },
      "lib": {
        "dependencies": { "allow": ["lib"] }
      },
      // another repo's deployment installs a package, so it reaches only libs, and only an app
      // imports it
      "package": {
        "dependencies": { "allow": ["lib"] }
      }
    }
  }
}
