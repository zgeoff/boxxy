{
  "name": "boxxy",
  "private": true,
  "description": "Decides which task a fleet of coding agents works on next, and measures what each task costs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "adapters/*",
      "libs/*",
      "packages/*"
    ],
    "catalog": {
      "@commitlint/cli": "21.2.4",
      "@faker-js/faker": "10.6.0",
      "@impz/client": "6.12.0",
      "@maschwenk/tsrslint": "0.1.6",
      "@modelcontextprotocol/client": "2.4.0",
      "@modelcontextprotocol/server": "2.4.0",
      "@msw/data": "1.1.8",
      "@mswjs/interceptors": "0.45.11",
      "@noslop/cli": "0.4.29",
      "@octokit/auth-app": "8.3.1",
      "@octokit/request": "10.0.16",
      "@orpc/client": "2.0.0-beta.50",
      "@orpc/contract": "2.0.0-beta.50",
      "@orpc/mcp": "2.0.0-beta.50",
      "@orpc/server": "2.0.0-beta.50",
      "@pepys/api": "0.4.1",
      "@pepys/cli": "0.4.1",
      "@pepys/ingest": "0.4.1",
      "@pepys/kit": "0.4.0",
      "@pepys/source-github": "0.4.0",
      "@pepys/source-telemetry": "0.4.0",
      "@pepys/testing": "0.4.0",
      "@stylistic/eslint-plugin": "5.10.0",
      "@tsconfig/strictest": "2.0.8",
      "@types/bun": "1.4.4",
      "@wringer/core": "0.2.0",
      "@wringer/gunshi": "0.2.0",
      "@wringer/http": "0.1.2",
      "@zgeoff/bun-test-extended": "0.2.3",
      "@zgeoff/chex": "0.3.4",
      "@zgeoff/commitlint-config": "0.1.0",
      "@zgeoff/format-codemod": "0.3.5",
      "@zgeoff/kysely-bun-sqlite": "0.3.2",
      "@zgeoff/mcp-auth": "0.2.1",
      "@zgeoff/oxfmt-config": "0.1.0",
      "@zgeoff/oxlint-config": "0.10.7",
      "@zgeoff/rig": "0.2.4",
      "@zgeoff/skill-gate": "0.2.28",
      "@zgeoff/std": "0.4.3",
      "elysia": "2.0.0-rc.3",
      "exact-mirror": "1.2.7",
      "knip": "6.44.1",
      "kysely": "0.29.8",
      "lefthook": "2.2.2",
      "liquidjs": "10.30.1",
      "msw": "3.0.3",
      "openapi-types": "12.1.3",
      "oxfmt": "0.75.0",
      "oxlint": "1.90.0",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.2",
      "tsrs": "0.18.0-ts7.1.0-dev.20260929",
      "turbo": "2.11.10",
      "typebox": "1.4.3",
      "typescript": "7.0.2",
      "xstate": "6.0.0-beta.2",
      "yaml": "2.9.1",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "bench": "rig bench",
    "boundaries": "turbo boundaries",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --quiet .; }",
    "format:check": "oxfmt --check . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --check --quiet .; }",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "tsgolint=$(tsrslint-path) && OXLINT_TSGOLINT_PATH=$tsgolint oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "chex prose AGENTS.md",
    "test": "rig unit",
    "typecheck": "tsrs --noEmit && turbo run typecheck",
    "files:branch": "bun scripts/read-branch-files.ts",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "test:related": "rig related",
    "check:commits": "bun scripts/run-commits-check.ts",
    "check:local-paths": "bun scripts/run-local-paths-check.ts",
    "check:docs": "chex prose length links readmes skill",
    "check:test-layout": "chex test-layout",
    "check:test-timeouts": "bun scripts/run-test-timeouts-check.ts",
    "check:dependency-gates": "bun scripts/dependency-gates/run-dependency-gates-check.ts",
    "check:workflows": "bun scripts/run-workflows-check.ts",
    "check:uncommitted": "bun scripts/run-uncommitted-check.ts",
    "memory-capped": "bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\"",
    "ci:dispatch-publish": "bun scripts/publish/dispatch-release-publish.ts",
    "ci:publish-packages": "bun scripts/publish/publish-packages.ts",
    "ci:release-cli-assets": "bun scripts/publish/release-cli-assets.ts",
    "ci:verify-gate": "bun scripts/ci/run-verify-gate.ts",
    "test:e2e": "rig e2e",
    "verify": "bun apps/cli/src/test-utils/verify/verify.ts",
    "verify:lint": "bun apps/cli/src/test-utils/verify/verify.ts lint"
  },
  "devDependencies": {
    "@boxxy/content-hash": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@maschwenk/tsrslint": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "@zgeoff/chex": "catalog:",
    "@zgeoff/commitlint-config": "catalog:",
    "@zgeoff/format-codemod": "catalog:",
    "@zgeoff/oxfmt-config": "catalog:",
    "@zgeoff/oxlint-config": "catalog:",
    "@zgeoff/rig": "catalog:",
    "@zgeoff/skill-gate": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "ts-pattern": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
