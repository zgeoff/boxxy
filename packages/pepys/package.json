{
  "name": "@boxxy/pepys",
  "version": "0.2.6",
  "description": "The pepys plug-in of boxxy, its fact sink and its report reader",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/packages/pepys#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "packages/pepys"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./sink": {
      "types": "./dist/create-pepys-fact-sink.d.ts",
      "default": "./src/create-pepys-fact-sink.ts"
    },
    "./reader": {
      "types": "./dist/create-pepys-reader.d.ts",
      "default": "./src/create-pepys-reader.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "glue": "pepys build src/boxxy-work-plugin.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/model": "workspace:*"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@pepys/api": "catalog:",
    "@pepys/cli": "catalog:",
    "@pepys/ingest": "catalog:",
    "@pepys/kit": "catalog:",
    "@pepys/source-github": "catalog:",
    "@pepys/source-telemetry": "catalog:",
    "@pepys/testing": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@orpc/client": "catalog:",
    "@pepys/api": "^0.4.0",
    "@pepys/ingest": "^0.4.0",
    "@pepys/kit": "^0.4.0",
    "@pepys/source-github": "^0.4.0",
    "@pepys/source-telemetry": "^0.4.0",
    "@pepys/testing": "^0.4.0",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@orpc/client": {
      "optional": true
    },
    "@pepys/api": {
      "optional": true
    },
    "@pepys/ingest": {
      "optional": true
    },
    "@pepys/source-github": {
      "optional": true
    },
    "@pepys/source-telemetry": {
      "optional": true
    },
    "@pepys/testing": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
