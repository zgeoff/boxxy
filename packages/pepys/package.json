{
  "name": "@boxxy/pepys",
  "version": "0.1.3",
  "description": "The pepys plug-in of boxxy, its fact sink and its report reader",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/packages/pepys#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "packages/pepys"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./sink": {
      "types": "./dist/create-pepys-fact-sink.d.ts",
      "default": "./src/create-pepys-fact-sink.ts"
    },
    "./reader": {
      "types": "./dist/create-pepys-reader.d.ts",
      "default": "./src/create-pepys-reader.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "glue": "pepys build src/boxxy-work-plugin.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/model": "workspace:*"
  },
  "devDependencies": {
    "@pepys/cli": "https://github.com/zgeoff/pepys/releases/download/preview-kit-0.0.1/pepys-cli-0.0.1.tgz",
    "@pepys/kit": "https://github.com/zgeoff/pepys/releases/download/preview-kit-0.0.1/pepys-kit-0.0.1.tgz",
    "@pepys/kysely-turso": "https://github.com/zgeoff/pepys/releases/download/preview-kit-0.0.1/pepys-kysely-turso-0.0.1.tgz",
    "@pepys/schema": "https://github.com/zgeoff/pepys/releases/download/preview-kit-0.0.1/pepys-schema-0.0.1.tgz",
    "@pepys/testing": "https://github.com/zgeoff/pepys/releases/download/preview-kit-0.0.1/pepys-testing-0.0.1.tgz",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@pepys/kit": "0.0.1",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
