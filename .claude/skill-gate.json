{
  "ignore": ["node_modules/", "dist/"],
  "gates": [
    { "match": "**/*.md", "skills": ["docs-writing"] },
    { "match": "**/*.ts", "skills": ["code-style"] },
    { "match": "**/*.test.ts", "skills": ["testing", "code-style"] },
    { "match": ".github/workflows/**", "skills": ["ci-design"] },
    { "match": "**/skills/*/SKILL.md", "skills": ["skill-writing", "docs-writing", "deslop"] },
    { "match": "**/skills/*/references/**", "skills": ["skill-writing", "docs-writing", "deslop"] }
  ]
}
