{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".reviews/**",
    ".worktrees/**",
    "docs/design/boxxy/sketches/**",
    "packages/pepys/src/generated/**"
  ],
  "rules": {
    // the layout doc's import pins: each outside library has one package that may import it, and
    // the modules and libs do no I/O
    "zgeoff/import-zones": [
      "error",
      {
        "workspaces": ["apps/*", "modules/*", "adapters/*", "libs/*", "packages/*"],
        "zones": {
          "packages": ["apps/**", "modules/**", "adapters/**", "libs/**", "packages/**"],
          "adapters": ["adapters/**"],
          "deployed": ["packages/**"],
          "domain": ["modules/**", "libs/**"],
          "rules": ["modules/rules/**"],
          "dispatch": ["modules/dispatch/**"],
          "store-sqlite": ["adapters/store-sqlite/**"],
          "worker-atc": ["adapters/worker-atc/**"],
          "caller-proof-imp": ["adapters/caller-proof-imp/**"],
          "pepys-package": ["packages/pepys/**"]
        },
        "edges": [
          {
            "name": "pepys",
            "from": ["domain"],
            "to": ["deployed"],
            "reason": "no module and no lib imports @boxxy/pepys; an app passes its sink and reader in through the ports"
          }
        ],
        "modules": [
          {
            "name": "sqlite",
            "modules": ["bun:sqlite", "kysely", "@zgeoff/kysely-bun-sqlite"],
            "allow": ["store-sqlite"],
            "reason": "only adapters/store-sqlite opens the database; use its ClaimStore"
          },
          {
            "name": "atc",
            "modules": ["@atcx/contract"],
            "allow": ["worker-atc"],
            "reason": "only adapters/worker-atc talks to atc; use its WorkerKind"
          },
          {
            "name": "imp-identity",
            "modules": ["@impz/client", "@impz/client/identity"],
            "allow": ["caller-proof-imp"],
            "reason": "only adapters/caller-proof-imp verifies the imp identity token; take its CallerProof"
          },
          {
            "name": "pepys-kit",
            "modules": ["@pepys/kit", "@pepys/kit/send", "@pepys/testing"],
            "allow": ["pepys-package"],
            "reason": "only packages/pepys binds to the pepys kit; take its sink and reader through the ports"
          },
          {
            "name": "yaml",
            "modules": ["yaml"],
            "allow": ["rules"],
            "reason": "only modules/rules parses YAML; load a rules checkout with its loadRules"
          },
          {
            "name": "xstate",
            "modules": ["xstate"],
            "allow": ["dispatch"],
            "reason": "only modules/dispatch runs the attempt machine; build attempt writes with its buildAttemptChange"
          },
          {
            "name": "domain-io",
            "modules": ["node:fs", "node:child_process", "node:net", "node:http", "node:https"],
            "from": ["domain"],
            "allow": [],
            "reason": "a module or a lib does no I/O; take an adapter through a port"
          }
        ],
        "globals": [
          {
            "name": "network",
            "globals": ["fetch"],
            "from": ["packages"],
            "allow": ["adapters", "deployed"],
            "reason": "only an adapter, or a package that another repo installs, calls an outside system"
          }
        ],
        "unresolved": [
          {
            "name": "unresolved",
            "from": ["packages"],
            "reason": "a package imports another only through the entries its exports list"
          }
        ]
      }
    ]
  },
  "overrides": [
    // a module or a lib takes time and settings as arguments, so a test or a replay sets them
    {
      "files": ["modules/**", "libs/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "Date", "message": "Take the time as an argument." },
          { "name": "process", "message": "Take settings as arguments." },
          {
            "name": "Bun",
            "message": "A module or a lib does no I/O; take an adapter through a port."
          }
        ]
      }
    },
    // the planning core reads concepts only through the loaded rules, so a new concept is one file
    {
      "files": [
        "modules/planning/src/build-frame.ts",
        "modules/planning/src/decide.ts",
        "modules/planning/src/propagate.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/concepts", "**/concepts/**", "**/concepts.ts"],
                "message": "The planning core never names a concept; read plug-ins from the loaded rules."
              }
            ]
          }
        ]
      }
    },
    // repo-sync delivers these scripts from zgeoff/tools and overwrites a local edit, so their verbs
    // are fixed at that source
    {
      "files": ["scripts/read-branch-files.ts", "scripts/run-related-tests.ts"],
      "rules": {
        "zgeoff/verb-contract": "off"
      }
    }
  ]
}
