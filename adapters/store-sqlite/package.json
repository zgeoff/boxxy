{
  "name": "@boxxy/store-sqlite",
  "version": "0.2.2",
  "description": "boxxy's store on SQLite",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/adapters/store-sqlite#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "adapters/store-sqlite"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "rig bench",
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/content-hash": "workspace:*",
    "@boxxy/model": "workspace:*",
    "@zgeoff/kysely-bun-sqlite": "catalog:",
    "kysely": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boxxy/dispatch": "workspace:*",
    "@zgeoff/rig": "catalog:"
  },
  "peerDependencies": {
    "@boxxy/dispatch": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@boxxy/dispatch": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
