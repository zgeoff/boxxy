{
  "name": "@boxxy/review-noslop",
  "version": "0.2.6",
  "description": "boxxy's review gate on noslop: the review command, and the check and post of its result",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/adapters/review-noslop#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "adapters/review-noslop"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/model": "workspace:*",
    "@noslop/cli": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:"
  },
  "peerDependencies": {
    "@faker-js/faker": "catalog:"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
