{
  "name": "@boxxy/forge-github",
  "version": "0.1.7",
  "description": "boxxy's forge port on GitHub: reads a pull request over the REST API",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/adapters/forge-github#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "adapters/forge-github"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/model": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boxxy/dispatch": "workspace:*"
  },
  "peerDependencies": {
    "@boxxy/dispatch": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@boxxy/dispatch": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
