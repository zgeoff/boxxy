{
  "name": "@boxxy/auth-oauth",
  "version": "0.2.1",
  "description": "boxxy's public door: an OAuth server for the owner's MCP endpoint, with passkey sign-in",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/adapters/auth-oauth#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "adapters/auth-oauth"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@boxxy/contract": "workspace:*",
    "@simplewebauthn/server": "catalog:",
    "@zgeoff/kysely-bun-sqlite": "catalog:",
    "better-auth": "catalog:",
    "elysia": "catalog:",
    "exact-mirror": "catalog:",
    "kysely": "catalog:",
    "openapi-types": "catalog:",
    "reflect-metadata": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
