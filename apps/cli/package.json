{
  "name": "@boxxy/cli",
  "version": "0.2.4",
  "description": "The boxxy command line",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/apps/cli#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "apps/cli"
  },
  "bin": {
    "boxxy": "./src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils/create-test-cli.ts",
    "!src/test-utils/verify",
    "hook-plugin",
    "dist",
    "!dist/test-utils/create-test-cli.d.ts",
    "!dist/test-utils/verify"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/contract": "workspace:*",
    "@boxxy/model": "workspace:*",
    "@orpc/client": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boxxy/dispatch": "workspace:*",
    "@boxxy/rules": "workspace:*",
    "@boxxy/server": "workspace:*",
    "@boxxy/store-sqlite": "workspace:*",
    "@wringer/core": "catalog:",
    "@wringer/gunshi": "catalog:",
    "@wringer/http": "catalog:",
    "tiny-invariant": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
