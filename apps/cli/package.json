{
  "name": "@boxxy/cli",
  "version": "0.1.3",
  "description": "The boxxy command line",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/apps/cli#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "apps/cli"
  },
  "bin": {
    "boxxy": "./src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "hook-plugin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/contract": "workspace:*",
    "@boxxy/model": "workspace:*",
    "@orpc/client": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
