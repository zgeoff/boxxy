{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // co-located test files never ship; declaration emit skips them, and the test utils that drive
  // the real server, which import the CLI's dev dependencies
  "exclude": ["src/**/*.test.ts", "src/test-utils/create-test-cli.ts", "src/test-utils/verify/**"]
}
