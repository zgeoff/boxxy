{
  "name": "@boxxy/server",
  "version": "0.1.6",
  "description": "The boxxy server: the API behind its three doors, and the runner loop",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/apps/server#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "apps/server"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "start": "bun src/main.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/caller-proof-imp": "workspace:*",
    "@boxxy/closeout": "workspace:*",
    "@boxxy/content-hash": "workspace:*",
    "@boxxy/contract": "workspace:*",
    "@boxxy/dispatch": "workspace:*",
    "@boxxy/forge-github": "workspace:*",
    "@boxxy/model": "workspace:*",
    "@boxxy/notifier-atc": "workspace:*",
    "@boxxy/pepys": "workspace:*",
    "@boxxy/planning": "workspace:*",
    "@boxxy/rules": "workspace:*",
    "@boxxy/store-sqlite": "workspace:*",
    "@boxxy/worker-atc": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/mcp": "catalog:",
    "@orpc/server": "catalog:",
    "elysia": "catalog:",
    "exact-mirror": "catalog:",
    "openapi-types": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
