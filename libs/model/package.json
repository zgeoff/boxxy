{
  "name": "@boxxy/model",
  "version": "0.1.9",
  "description": "The types that boxxy's packages share",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/libs/model#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "libs/model"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/content-hash": "workspace:*",
    "tiny-invariant": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:"
  },
  "peerDependencies": {
    "@faker-js/faker": "catalog:"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
