{
  "name": "@boxxy/dispatch",
  "version": "0.1.6",
  "description": "boxxy's dispatch: claims the next task for an agent",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/modules/dispatch#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "modules/dispatch"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/closeout": "workspace:*",
    "@boxxy/content-hash": "workspace:*",
    "@boxxy/model": "workspace:*",
    "@boxxy/planning": "workspace:*",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@boxxy/rules": "workspace:*"
  },
  "peerDependencies": {
    "@boxxy/rules": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@boxxy/rules": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
