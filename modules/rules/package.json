{
  "name": "@boxxy/rules",
  "version": "0.1.8",
  "description": "boxxy's rules loader: checks a rules checkout and builds the plug-in registry",
  "homepage": "https://github.com/zgeoff/boxxy/tree/main/modules/rules#readme",
  "bugs": "https://github.com/zgeoff/boxxy/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/boxxy.git",
    "directory": "modules/rules"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "example",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./example/*": "./example/*",
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@boxxy/content-hash": "workspace:*",
    "@boxxy/model": "workspace:*",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
